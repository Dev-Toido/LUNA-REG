# ==============================================================================
# LUNA-REG: Production Environment Configuration Template (.env.example)
# Planetary Image Registration Workstation (ISRO SAC SIH26166)
# ==============================================================================

# 1. Primary Versioned REST API Base URL
# Points to the FastAPI backend v1 API routes (/products, /pairs, /regions)
# Default for local development: http://127.0.0.1:8000/api/v1
# Production example: https://api.luna-reg.isro.gov.in/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# 2. Backend Root Server URL
# Points to server root for system telemetry (/health, /api/info) and physical raster assets
# Default for local development: http://127.0.0.1:8000
# Production example: https://api.luna-reg.isro.gov.in
VITE_BACKEND_ROOT=http://127.0.0.1:8000

# 3. Client Runtime Override Notice
# Operators can also override this value on-the-fly without rebuilding using the
# "API Connection Inspector" modal accessible from the top navigation status badge.
# Runtime values persist in localStorage['LUNA_REG_VITE_API_BASE_URL'].
